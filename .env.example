# Supabase (Project Settings > API Keys). Key mới: publishable / secret
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chỉ server. Không bao giờ thêm tiền tố NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# URL công khai của app (local: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
