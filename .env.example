# Supabase (Project Settings > API Keys). Key mới: publishable / secret
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chỉ server. Không bao giờ thêm tiền tố NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# URL công khai của app, chỉ server (local: http://localhost:3000). Khớp "Authorization Callback Domain" của app Strava
APP_URL=http://localhost:3000

# Strava (strava.com/settings/api). Chỉ server
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Khoá AES-256 mã hoá token Strava trước khi lưu DB: 32 byte base64. Tạo bằng `openssl rand -base64 32`. Không đổi sau khi đã có dữ liệu
TOKEN_ENC_KEY=

# Webhook Strava: chuỗi bất kỳ, dùng khi tạo subscription (`npm run strava:subscribe create`). Chỉ server
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Bí mật cho các route /api/cron/* (GitHub Actions gửi trong header Authorization). Tạo bằng `openssl rand -hex 32`. Chỉ server
CRON_SECRET=

# Cloudflare R2 lưu ảnh event (R2 > Manage API tokens, quyền Object Read & Write cho đúng bucket). Chỉ server
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Địa chỉ công khai của bucket (custom domain, ví dụ https://img.clr.vn), không có dấu / ở cuối
R2_PUBLIC_BASE_URL=

# Webhook ngân hàng SePay (task 16): khoá API tạo ở my.sepay.vn khi cấu hình webhook, SePay gửi trong header "Authorization: Apikey <khoá>". Chỉ server
SEPAY_API_KEY=
