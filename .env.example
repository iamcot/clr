# Supabase (Project Settings > API Keys). Key mới: publishable / secret
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chỉ server. Không bao giờ thêm tiền tố NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# URL công khai của app, chỉ server (local: http://localhost:3000). Khớp "Authorization Callback Domain" của app Strava
APP_URL=http://localhost:3000

# Strava (strava.com/settings/api). Chỉ server
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Khoá AES-256 mã hoá token Strava trước khi lưu DB: 32 byte base64. Tạo bằng `openssl rand -base64 32`. Không đổi sau khi đã có dữ liệu
TOKEN_ENC_KEY=
